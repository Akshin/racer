{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    // Типы ant-plus-next собраны без расширений в путях и не проходят проверку под nodenext.
    "skipLibCheck": true,
    // Sources run directly через `node src/index.ts` (native type stripping),
    // поэтому импорты указывают на .ts и не должны содержать неудаляемый синтаксис.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
