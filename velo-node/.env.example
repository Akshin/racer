# Скопируйте в .env и поправьте под себя.

# WebSocket-сервер для velo-game
WS_HOST=0.0.0.0
WS_PORT=8080
# Частота отправки телеметрии, Гц
TICK_HZ=20

# Откуда берём каденс:
#   ble  — датчики Wahoo RPM по Bluetooth (встроенный адаптер)
#   ant  — те же датчики по ANT+ (нужен USB-свисток ANT USB-m или Garmin USB2)
#   mock — симулятор для разработки фронта без железа
SOURCE=ble

# Привязка датчиков к игрокам: для ble — BLE id (macOS), MAC-адрес (Linux) или
# localName; для ant — ANT+ Device ID. Пусто = автопривязка в порядке обнаружения.
# Идентификаторы найденных датчиков печатаются в лог.
P1_SENSOR=
P2_SENSOR=

# Виртуальная передача: скорость = каденс × окружность колеса × передаточное число.
# 2.096 м — 700x25c; 3.0 — примерно 48/16. При 80 об/мин это ~30 км/ч.
WHEEL_CIRCUMFERENCE_M=2.096
GEAR_RATIO=3.0

# Нет новых оборотов дольше SENSOR_TIMEOUT_MS — каденс считается нулевым.
SENSOR_TIMEOUT_MS=2000
# Постоянная времени сглаживания: больше — плавнее разгон/торможение.
SMOOTHING_TAU_MS=350
